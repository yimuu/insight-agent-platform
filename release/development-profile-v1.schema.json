{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight.platform/schemas/development-profile-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "environment_class", "deployment", "production_qualification", "release_images", "dependencies", "starter", "features", "aliases", "qualification"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "insight.dev.feature-registry/v1"},
    "environment_class": {"const": "development"},
    "deployment": {"const": "single_node"},
    "production_qualification": {"const": false},
    "release_images": {"const": ["runtime", "sandbox_guest", "console"]},
    "dependencies": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["name", "image"], "properties": {"name": {"enum": ["postgresql", "nats", "object_storage"]}, "image": {"type": "string", "pattern": "^[A-Za-z0-9./_-]+@sha256:[0-9a-f]{64}$"}}}},
    "starter": {"$ref": "#/$defs/closure"},
    "features": {"type": "object", "additionalProperties": false, "required": ["context", "mcp", "model", "remote-capability", "wasi"], "properties": {"context": {"$ref": "#/$defs/feature"}, "mcp": {"$ref": "#/$defs/feature"}, "model": {"$ref": "#/$defs/feature"}, "remote-capability": {"$ref": "#/$defs/feature"}, "wasi": {"$ref": "#/$defs/feature"}}},
    "aliases": {"const": {"all": ["context", "mcp", "model", "remote-capability", "wasi"]}},
    "qualification": {"const": {"dev_feature": false, "levels": {"L4": "not_run", "L5": "not_run", "L6": "not_run"}}}
  },
  "$defs": {
    "names": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"}},
    "closure": {"type": "object", "additionalProperties": false, "required": ["roles", "configs", "identities", "readiness", "memory_mib", "cpu_millicores"], "properties": {"roles": {"$ref": "#/$defs/names"}, "configs": {"$ref": "#/$defs/names"}, "identities": {"$ref": "#/$defs/names"}, "readiness": {"$ref": "#/$defs/names"}, "memory_mib": {"type": "integer", "minimum": 1, "maximum": 8192}, "cpu_millicores": {"type": "integer", "minimum": 1, "maximum": 4000}}},
    "feature": {"type": "object", "additionalProperties": false, "required": ["roles", "configs", "identities", "readiness", "provides", "memory_mib", "cpu_millicores"], "properties": {"roles": {"$ref": "#/$defs/names"}, "configs": {"$ref": "#/$defs/names"}, "identities": {"$ref": "#/$defs/names"}, "readiness": {"$ref": "#/$defs/names"}, "provides": {"$ref": "#/$defs/names"}, "memory_mib": {"type": "integer", "minimum": 1, "maximum": 8192}, "cpu_millicores": {"type": "integer", "minimum": 1, "maximum": 4000}}}
  }
}
