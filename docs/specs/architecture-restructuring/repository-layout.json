  "new_packages": [
    {
      "package": "insight-platform-plan",
      "target": "crates/definitions/platform-plan",
      "extract_from": [
        "crates/platform-orchestrator/src/lib.rs",
        "crates/platform-orchestrator/src/expression.rs"
      ],
      "purpose": "Pure RuntimePlan/RuntimeNode, typed expressions and definition validation; runtime transitions remain in platform-orchestrator."
    },
    {
      "package": "insight-platform-agent-compiler",
      "target": "crates/authoring/platform-agent-compiler",
      "extract_from": [
        "crates/insight-cli/src/agent_compiler.rs"
      ],
      "purpose": "Pure shared authoring semantics, lowering, canonical output and diagnostics. File/network/publication remain in apps."
    },
    {
      "package": "insight-platform-agent-compiler-wasm",
      "target": "crates/authoring/platform-agent-compiler-wasm",
      "extract_from": [],
      "purpose": "Bounded WASM binding to the same compiler, no second compiler semantics."
    },
    {
      "package": "insight-platform-deployment-contracts",
      "target": "crates/deployment/platform-deployment-contracts",
      "extract_from": [
        "crates/platform-contracts/src/qualification.rs",
        "crates/platform-contracts/src/runtime_config.rs"
      ],
      "purpose": "Deployment/profile/release/qualification composition types; runtime identity and small role vocabulary remain in foundation worker contracts."
    },
    {
      "package": "insight-platform-opensandbox-executor",
      "target": "crates/adapters/platform-opensandbox-executor",
      "extract_from": [
        "crates/platform-sandbox/src/dispatcher.rs",
        "crates/platform-sandbox/src/opensandbox.rs"
      ],
      "purpose": "Physical OpenSandbox orchestration adapter; pure sandbox decisions and ports remain in the sandbox domain."
    },
    {
      "package": "insight-platform-contract-tooling",
      "target": "tools/rust/platform-contract-tooling",
      "extract_from": [
        "crates/platform-contracts/src/machine.rs",
        "crates/platform-contracts/src/bin/check_platform_contracts.rs",
        "crates/platform-contracts/src/bin/platform_qualification.rs"
      ],
      "purpose": "Contract generation/checking and qualification CLI composition. Runtime registry predicates stay in foundation. Preserve existing binary names."
    },
    {
      "package": "insight-platform-storage-tooling",
      "target": "tools/rust/platform-storage-tooling",
      "extract_from": [
        "crates/platform-postgres/src/bin"
      ],
      "purpose": "Provisioning/bootstrap/schema-check binary composition; immutable migrations and schema definitions remain owned by PostgreSQL adapter. Preserve binary names and remove runtime DDL access."
    },
    {
      "package": "insight-platform-outbox-worker",
      "target": "apps/services/platform-outbox-worker",
      "extract_from": [],
      "purpose": "New narrow Outbox delivery role with its own lifecycle, limited PostgreSQL Outbox/Event access and JetStream subject publishing. Reuses the existing Outbox authority; no new Job or business queue. Deployment contracts, grants, profiles, network policy, image closure and CI qualification must include this role together."
    }
  ],
