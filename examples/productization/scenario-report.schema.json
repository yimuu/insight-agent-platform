{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:insight:productization:scenario-report:v1",
  "title": "Insight Productization Golden Scenario Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_kind",
    "scenario_id",
    "contract_profile",
    "profile",
    "qualification_run_id",
    "actual_profile",
    "profile_digest",
    "evidence_inputs",
    "automation_layer",
    "source_revision",
    "environment",
    "started_at",
    "finished_at",
    "status",
    "entrypoints",
    "assertions",
    "failure_probes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "report_kind": { "const": "insight.productization.scenario-report/v1" },
    "scenario_id": { "type": "string", "minLength": 1, "maxLength": 96 },
    "contract_profile": { "const": "insight.platform/v1" },
    "profile": {
      "description": "The scenario's minimum required feature closure from the checked manifest; a report may be produced by an actual superset such as all.",
      "enum": [
        "starter",
        "starter+context",
        "starter+mcp,remote-capability",
        "starter+model",
        "starter+remote-capability",
        "starter+remote-capability,sandbox",
        "starter+sandbox"
      ]
    },
    "qualification_run_id": {
      "description": "Digest identity shared by every report produced by one fresh productization journey; a sandbox closure uses the qualification_run_id generated by its raw OpenSandbox L3 evidence.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "actual_profile": {
      "description": "The canonical feature closure that actually produced this report.",
      "enum": [
        "all",
        "starter",
        "starter+context",
        "starter+context,mcp",
        "starter+context,mcp,model",
        "starter+context,mcp,model,remote-capability",
        "starter+context,mcp,model,remote-capability,sandbox",
        "starter+context,mcp,remote-capability",
        "starter+context,mcp,remote-capability,sandbox",
        "starter+context,model",
        "starter+context,model,remote-capability",
        "starter+context,model,remote-capability,sandbox",
        "starter+context,remote-capability",
        "starter+context,remote-capability,sandbox",
        "starter+mcp",
        "starter+mcp,model",
        "starter+mcp,model,remote-capability",
        "starter+mcp,model,remote-capability,sandbox",
        "starter+mcp,remote-capability",
        "starter+mcp,remote-capability,sandbox",
        "starter+model",
        "starter+model,remote-capability",
        "starter+model,remote-capability,sandbox",
        "starter+remote-capability",
        "starter+remote-capability,sandbox"
      ]
    },
    "profile_digest": {
      "description": "Exact digest recorded by the runtime profile used for the journey.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_inputs": {
      "description": "Closed digests of external evidence consumed by this scenario; empty when none is required.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "opensandbox_qualification": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "automation_layer": { "enum": ["P2", "P3"] },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "fresh_profile"],
      "properties": {
        "os": { "type": "string", "minLength": 1, "maxLength": 64 },
        "architecture": { "type": "string", "minLength": 1, "maxLength": 64 },
        "fresh_profile": { "const": true }
      }
    },
    "started_at": {
      "description": "Start of the complete evidence window; the sandbox scenario must start no later than its bound raw OpenSandbox L3 evidence.",
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "description": "End of the complete evidence window, including any Console observation and the bound raw OpenSandbox L3 evidence.",
      "type": "string",
      "format": "date-time"
    },
    "status": { "enum": ["passed", "incomplete", "failed"] },
    "entrypoints": { "$ref": "#/$defs/checks" },
    "assertions": { "$ref": "#/$defs/checks" },
    "failure_probes": { "$ref": "#/$defs/checks" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scenario_id": { "const": "sandbox-and-remote-framework-capability" }
        },
        "required": ["scenario_id"]
      },
      "then": {
        "properties": {
          "evidence_inputs": { "required": ["opensandbox_qualification"] }
        }
      },
      "else": {
        "properties": {
          "evidence_inputs": { "maxProperties": 0 }
        }
      }
    }
  ],
  "$defs": {
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 96 },
          "status": { "enum": ["passed", "failed", "not_run"] },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    }
  }
}
