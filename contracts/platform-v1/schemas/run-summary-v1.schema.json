{
  "$id": "urn:insight:platform:v1:run-summary-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "pattern": "^agt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "agent_name": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "type": "string"
    },
    "result_available": {
      "type": "boolean"
    },
    "run_id": {
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "started_at": {
      "oneOf": [
        {
          "$ref": "nominal/utc-timestamp.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "waiting",
        "cancelling",
        "succeeded",
        "failed",
        "cancelled",
        "timed_out"
      ],
      "type": "string"
    },
    "terminal_at": {
      "oneOf": [
        {
          "$ref": "nominal/utc-timestamp.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "waiting_task_count": {
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "agent_name",
    "agent_id",
    "state",
    "started_at",
    "terminal_at",
    "waiting_task_count",
    "result_available"
  ],
  "title": "RunSummaryV1",
  "type": "object"
}
