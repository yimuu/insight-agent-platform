{
  "$id": "urn:insight:platform:v1:agent-summary-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "pattern": "^agt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "display_name": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "environment": {
      "oneOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "latest_run_state": {
      "oneOf": [
        {
          "enum": [
            "queued",
            "running",
            "waiting",
            "cancelling",
            "succeeded",
            "failed",
            "cancelled",
            "timed_out"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "type": "string"
    },
    "published_at": {
      "oneOf": [
        {
          "$ref": "nominal/utc-timestamp.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "required_features": {
      "items": {
        "enum": [
          "model"
        ],
        "type": "string"
      },
      "maxItems": 16,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": 1
    },
    "state": {
      "enum": [
        "draft",
        "validating",
        "publishing",
        "ready",
        "blocked"
      ],
      "type": "string"
    },
    "updated_at": {
      "$ref": "nominal/utc-timestamp.schema.json"
    }
  },
  "required": [
    "schema_version",
    "name",
    "display_name",
    "agent_id",
    "state",
    "environment",
    "updated_at",
    "published_at",
    "required_features",
    "latest_run_state"
  ],
  "title": "AgentSummaryV1",
  "type": "object"
}
