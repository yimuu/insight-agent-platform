{
  "$id": "urn:insight:platform:v1:candidate-manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Content-addressed CI/CD closure for one exact source, contract, schema, image, worker, configuration, limit, policy and qualification profile set; it is not runtime state.",
  "properties": {
    "component_images": {
      "additionalProperties": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "maxProperties": 256,
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "management_api",
          "runtime_api",
          "scheduler_recovery",
          "model_worker",
          "capability_native_worker",
          "capability_remote_worker",
          "registry_validation_worker",
          "context_worker",
          "mcp_host",
          "sandbox_dispatcher",
          "opensandbox_server",
          "opensandbox_controller",
          "artifact_gateway",
          "artifact_data_worker",
          "artifact_maintenance",
          "egress_secret_broker"
        ]
      },
      "type": "object"
    },
    "contract_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "type": "string"
    },
    "database_schema_version": {
      "maximum": 4294967295,
      "minimum": 1,
      "type": "integer"
    },
    "deployment_config_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "git_commit": {
      "pattern": "^(sha1:[0-9a-f]{40}|sha256:[0-9a-f]{64})$",
      "type": "string"
    },
    "hard_limit_profile_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "policy_baseline_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "qualification_profile_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "sandbox_runner_image_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "worker_manifests": {
      "description": "Canonical ascending digest set; Rust validation additionally enforces ordering and exact installed WorkerManifest closure.",
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 512,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "git_commit",
    "contract_digest",
    "database_schema_version",
    "component_images",
    "sandbox_runner_image_digest",
    "worker_manifests",
    "deployment_config_digest",
    "hard_limit_profile_digest",
    "policy_baseline_digest",
    "qualification_profile_digest",
    "created_at"
  ],
  "title": "CandidateManifest",
  "type": "object"
}
