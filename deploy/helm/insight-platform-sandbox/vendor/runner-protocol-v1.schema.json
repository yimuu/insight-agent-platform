{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight.platform/contracts/sandbox-runner-v1.schema.json",
  "title": "Insight Sandbox Armed Runner Protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "listen_port", "operations", "frames"],
  "properties": {
    "protocol_version": {"const": 1},
    "listen_port": {"const": 18080},
    "operations": {
      "type": "array",
      "prefixItems": [
        {"const": {"method": "GET", "path": "/v1/state", "response": "state"}},
        {"const": {"method": "POST", "path": "/v1/activate", "request": "activation", "response": "state"}},
        {"const": {"method": "GET", "path": "/v1/result", "response": "result"}}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "frames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config", "activation", "state", "result"],
      "properties": {
        "config": {"$ref": "#/$defs/config"},
        "activation": {"$ref": "#/$defs/activation"},
        "state": {"$ref": "#/$defs/state"},
        "result": {"$ref": "#/$defs/result"}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "boundedId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$"},
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "execution_request_digest", "input_schema_digest", "input_digest", "output_schema_digest", "activation_token_digest", "package_argv", "maximum_input_bytes", "maximum_output_bytes", "maximum_diagnostic_bytes", "maximum_processes", "wall_milliseconds"],
      "properties": {
        "schema_version": {"const": 1},
        "execution_request_digest": {"$ref": "#/$defs/digest"},
        "input_schema_digest": {"$ref": "#/$defs/digest"},
        "input_digest": {"$ref": "#/$defs/digest"},
        "output_schema_digest": {"$ref": "#/$defs/digest"},
        "activation_token_digest": {"$ref": "#/$defs/digest"},
        "package_argv": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "maximum_input_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "maximum_output_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "maximum_diagnostic_bytes": {"type": "integer", "minimum": 1024, "maximum": 65536},
        "maximum_processes": {"type": "integer", "minimum": 1, "maximum": 4096},
        "wall_milliseconds": {"type": "integer", "minimum": 1, "maximum": 3600000}
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["magic", "schema_version", "activation_token", "boot_id", "execution_request_digest", "input_schema_digest", "input_digest", "declared_input_bytes", "input", "frame_digest"],
      "properties": {
        "magic": {"const": "insight.sandbox.runner/v1"},
        "schema_version": {"const": 1},
        "activation_token": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "boot_id": {"$ref": "#/$defs/boundedId"},
        "execution_request_digest": {"$ref": "#/$defs/digest"},
        "input_schema_digest": {"$ref": "#/$defs/digest"},
        "input_digest": {"$ref": "#/$defs/digest"},
        "declared_input_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "input": true,
        "frame_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["magic", "schema_version", "sandbox_id", "boot_id", "execution_request_digest", "phase", "frame_digest"],
      "properties": {
        "magic": {"const": "insight.sandbox.runner/v1"},
        "schema_version": {"const": 1},
        "sandbox_id": {"$ref": "#/$defs/boundedId"},
        "boot_id": {"$ref": "#/$defs/boundedId"},
        "execution_request_digest": {"$ref": "#/$defs/digest"},
        "phase": {"enum": ["armed", "activation_latched", "started", "succeeded", "failed", "unknown_prior_activation"]},
        "frame_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "output", "output_schema_digest", "output_digest", "declared_output_bytes"],
      "properties": {
        "outcome": {"const": "succeeded"},
        "output": true,
        "output_schema_digest": {"$ref": "#/$defs/digest"},
        "output_digest": {"$ref": "#/$defs/digest"},
        "declared_output_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "failure_class", "diagnostic_digest", "diagnostic_bytes"],
      "properties": {
        "outcome": {"const": "failed"},
        "failure_class": {"enum": ["package_failed", "package_timed_out", "output_invalid", "output_too_large", "runner_failure"]},
        "diagnostic_digest": {"$ref": "#/$defs/digest"},
        "diagnostic_bytes": {"type": "integer", "minimum": 0, "maximum": 65536}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["magic", "schema_version", "execution_request_digest", "boot_id", "result", "frame_digest"],
      "properties": {
        "magic": {"const": "insight.sandbox.runner/v1"},
        "schema_version": {"const": 1},
        "execution_request_digest": {"$ref": "#/$defs/digest"},
        "boot_id": {"$ref": "#/$defs/boundedId"},
        "result": {"oneOf": [{"$ref": "#/$defs/success"}, {"$ref": "#/$defs/failure"}]},
        "frame_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
