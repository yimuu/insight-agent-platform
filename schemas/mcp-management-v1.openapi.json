{
  "openapi": "3.1.0",
  "info": {
    "title": "Insight MCP Management API",
    "version": "1.0.0",
    "description": "Installation-scoped Operator API for explicit MCP discovery, review, publication and lifecycle control. All responses are private and non-cacheable."
  },
  "servers": [{"url": "/"}],
  "security": [{"operatorBearer": []}],
  "tags": [
    {"name": "Servers"}, {"name": "Discovery"}, {"name": "Imports"},
    {"name": "Publication"}, {"name": "Lifecycle"}
  ],
  "paths": {
    "/v1/admin/mcp/servers": {
      "get": {
        "operationId": "listMcpServers", "tags": ["Servers"],
        "parameters": [
          {"$ref": "#/components/parameters/State"}, {"$ref": "#/components/parameters/Limit"},
          {"$ref": "#/components/parameters/Cursor"}
        ],
        "responses": {"200": {"$ref": "#/components/responses/Ok"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}}
      },
      "post": {
        "operationId": "createMcpServer", "tags": ["Servers"],
        "parameters": [{"$ref": "#/components/parameters/RequestId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "mcp-management-v1.json#/$defs/createServerRequest"}}}},
        "responses": {"201": {"$ref": "#/components/responses/Created"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/v1/admin/mcp/servers/{server_id}": {
      "parameters": [{"$ref": "#/components/parameters/ServerId"}],
      "get": {"operationId": "getMcpServer", "tags": ["Servers"], "responses": {"200": {"$ref": "#/components/responses/OkWithEtag"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}},
      "delete": {
        "operationId": "deleteMcpServer", "tags": ["Servers"],
        "parameters": [{"$ref": "#/components/parameters/RequestId"}, {"$ref": "#/components/parameters/IfMatch"}],
        "responses": {"200": {"$ref": "#/components/responses/Ok"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "412": {"$ref": "#/components/responses/Error"}, "428": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/v1/admin/mcp/servers/{server_id}/draft": {
      "parameters": [{"$ref": "#/components/parameters/ServerId"}],
      "get": {"operationId": "getMcpServerDraft", "tags": ["Servers"], "responses": {"200": {"$ref": "#/components/responses/OkWithEtag"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}},
      "put": {
        "operationId": "replaceMcpServerDraft", "tags": ["Servers"],
        "parameters": [{"$ref": "#/components/parameters/RequestId"}, {"$ref": "#/components/parameters/IfMatch"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "mcp-management-v1.json#/$defs/draft"}}}},
        "responses": {"200": {"$ref": "#/components/responses/OkWithEtag"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "412": {"$ref": "#/components/responses/Error"}, "428": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/v1/admin/mcp/servers/{server_id}/manifests": {
      "parameters": [{"$ref": "#/components/parameters/ServerId"}],
      "get": {"operationId": "listMcpManifests", "tags": ["Discovery"], "parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Cursor"}], "responses": {"200": {"$ref": "#/components/responses/Ok"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}},
      "post": {
        "operationId": "createMcpManifest", "tags": ["Discovery"], "parameters": [{"$ref": "#/components/parameters/RequestId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "mcp-management-v1.json#/$defs/manifestUploadRequest"}}}},
        "responses": {"201": {"$ref": "#/components/responses/Created"}, "400": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/v1/admin/mcp/servers/{server_id}/manifests/{manifest_id}": {
      "parameters": [{"$ref": "#/components/parameters/ServerId"}, {"$ref": "#/components/parameters/ManifestId"}],
      "get": {"operationId": "getMcpManifest", "tags": ["Discovery"], "responses": {"200": {"$ref": "#/components/responses/Ok"}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/admin/mcp/servers/{server_id}/discoveries": {
      "parameters": [{"$ref": "#/components/parameters/ServerId"}],
      "get": {"operationId": "listMcpDiscoveries", "tags": ["Discovery"], "parameters": [{"$ref": "#/components/parameters/DiscoveryStatus"}, {"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Cursor"}], "responses": {"200": {"$ref": "#/components/responses/Ok"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}},
      "post": {
        "operationId": "createMcpDiscovery", "tags": ["Discovery"], "parameters": [{"$ref": "#/components/parameters/RequestId"}, {"$ref": "#/components/parameters/IfMatch"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "mcp-management-v1.json#/$defs/closedEmptyRequest"}}}},
        "responses": {"202": {"$ref": "#/components/responses/Accepted"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "412": {"$ref": "#/components/responses/Error"}, "428": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/v1/admin/mcp/servers/{server_id}/discoveries/{discovery_id}": {
      "parameters": [{"$ref": "#/components/parameters/ServerId"}, {"$ref": "#/components/parameters/DiscoveryId"}],
      "get": {"operationId": "getMcpDiscovery", "tags": ["Discovery"], "responses": {"200": {"$ref": "#/components/responses/Ok"}, "404": {"$ref": "#/components/responses/Error"}}},
      "delete": {"operationId": "cancelMcpDiscovery", "tags": ["Discovery"], "parameters": [{"$ref": "#/components/parameters/RequestId"}], "responses": {"200": {"$ref": "#/components/responses/Ok"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/admin/mcp/servers/{server_id}/discoveries/{discovery_id}/tools": {"parameters": [{"$ref": "#/components/parameters/ServerId"}, {"$ref": "#/components/parameters/DiscoveryId"}], "get": {"operationId": "listMcpDiscoveryTools", "tags": ["Discovery"], "parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Cursor"}], "responses": {"200": {"$ref": "#/components/responses/Ok"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/v1/admin/mcp/servers/{server_id}/discoveries/{discovery_id}/resources": {"parameters": [{"$ref": "#/components/parameters/ServerId"}, {"$ref": "#/components/parameters/DiscoveryId"}], "get": {"operationId": "listMcpDiscoveryResources", "tags": ["Discovery"], "parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Cursor"}], "responses": {"200": {"$ref": "#/components/responses/Ok"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/v1/admin/mcp/servers/{server_id}/discoveries/{discovery_id}/prompts": {"parameters": [{"$ref": "#/components/parameters/ServerId"}, {"$ref": "#/components/parameters/DiscoveryId"}], "get": {"operationId": "listMcpDiscoveryPrompts", "tags": ["Discovery"], "parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Cursor"}], "responses": {"200": {"$ref": "#/components/responses/Ok"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/v1/admin/mcp/servers/{server_id}/tool-import-previews": {
      "parameters": [{"$ref": "#/components/parameters/ServerId"}],
      "post": {"operationId": "previewMcpToolImports", "tags": ["Imports"], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "mcp-management-v1.json#/$defs/toolImportPreviewRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/Ok"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/admin/mcp/servers/{server_id}/draft/imports/tools": {"parameters": [{"$ref": "#/components/parameters/ServerId"}], "put": {"operationId": "replaceMcpToolImports", "tags": ["Imports"], "parameters": [{"$ref": "#/components/parameters/RequestId"}, {"$ref": "#/components/parameters/IfMatch"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "mcp-management-v1.json#/$defs/toolImportsRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/OkWithEtag"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "412": {"$ref": "#/components/responses/Error"}, "428": {"$ref": "#/components/responses/Error"}}}},
    "/v1/admin/mcp/servers/{server_id}/draft/imports/resources": {"parameters": [{"$ref": "#/components/parameters/ServerId"}], "put": {"operationId": "replaceMcpResourceImports", "tags": ["Imports"], "parameters": [{"$ref": "#/components/parameters/RequestId"}, {"$ref": "#/components/parameters/IfMatch"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "mcp-management-v1.json#/$defs/resourceImportsRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/OkWithEtag"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "412": {"$ref": "#/components/responses/Error"}, "428": {"$ref": "#/components/responses/Error"}}}},
    "/v1/admin/mcp/servers/{server_id}/draft/imports/prompts": {"parameters": [{"$ref": "#/components/parameters/ServerId"}], "put": {"operationId": "replaceMcpPromptImports", "tags": ["Imports"], "parameters": [{"$ref": "#/components/parameters/RequestId"}, {"$ref": "#/components/parameters/IfMatch"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "mcp-management-v1.json#/$defs/promptImportsRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/OkWithEtag"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "412": {"$ref": "#/components/responses/Error"}, "428": {"$ref": "#/components/responses/Error"}}}},
    "/v1/admin/mcp/servers/{server_id}/validations": {
      "parameters": [{"$ref": "#/components/parameters/ServerId"}],
      "post": {"operationId": "createMcpValidation", "tags": ["Publication"], "parameters": [{"$ref": "#/components/parameters/RequestId"}, {"$ref": "#/components/parameters/IfMatch"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "mcp-management-v1.json#/$defs/validationRequest"}}}}, "responses": {"201": {"$ref": "#/components/responses/Created"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "412": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}, "428": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/admin/mcp/servers/{server_id}/validations/{validation_id}": {"parameters": [{"$ref": "#/components/parameters/ServerId"}, {"$ref": "#/components/parameters/ValidationId"}], "get": {"operationId": "getMcpValidation", "tags": ["Publication"], "responses": {"200": {"$ref": "#/components/responses/Ok"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/v1/admin/mcp/servers/{server_id}/revisions": {
      "parameters": [{"$ref": "#/components/parameters/ServerId"}],
      "get": {"operationId": "listMcpRevisions", "tags": ["Publication"], "parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Cursor"}], "responses": {"200": {"$ref": "#/components/responses/Ok"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}},
      "post": {"operationId": "publishMcpRevision", "tags": ["Publication"], "parameters": [{"$ref": "#/components/parameters/RequestId"}, {"$ref": "#/components/parameters/IfMatch"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "mcp-management-v1.json#/$defs/publishRequest"}}}}, "responses": {"201": {"$ref": "#/components/responses/Created"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "412": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}, "428": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/admin/mcp/servers/{server_id}/revisions/{revision_id}": {"parameters": [{"$ref": "#/components/parameters/ServerId"}, {"$ref": "#/components/parameters/RevisionId"}], "get": {"operationId": "getMcpRevision", "tags": ["Publication"], "responses": {"200": {"$ref": "#/components/responses/Ok"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/v1/admin/mcp/servers/{server_id}/active-revision": {
      "parameters": [{"$ref": "#/components/parameters/ServerId"}, {"$ref": "#/components/parameters/RequestId"}, {"$ref": "#/components/parameters/IfMatch"}],
      "put": {"operationId": "activateMcpRevision", "tags": ["Lifecycle"], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "mcp-management-v1.json#/$defs/activateRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/OkWithEtag"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "412": {"$ref": "#/components/responses/Error"}, "428": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}},
      "delete": {"operationId": "disableMcpServer", "tags": ["Lifecycle"], "responses": {"200": {"$ref": "#/components/responses/OkWithEtag"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "412": {"$ref": "#/components/responses/Error"}, "428": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/admin/mcp/servers/{server_id}/retirement": {
      "parameters": [{"$ref": "#/components/parameters/ServerId"}],
      "post": {"operationId": "retireMcpServer", "tags": ["Lifecycle"], "parameters": [{"$ref": "#/components/parameters/RequestId"}, {"$ref": "#/components/parameters/IfMatch"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "mcp-management-v1.json#/$defs/retirementRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/OkWithEtag"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "412": {"$ref": "#/components/responses/Error"}, "428": {"$ref": "#/components/responses/Error"}}}
    }
  },
  "components": {
    "securitySchemes": {"operatorBearer": {"type": "http", "scheme": "bearer", "bearerFormat": "opaque operator credential"}},
    "parameters": {
      "ServerId": {"name": "server_id", "in": "path", "required": true, "schema": {"$ref": "mcp-management-v1.json#/$defs/serverId"}},
      "ManifestId": {"name": "manifest_id", "in": "path", "required": true, "schema": {"type": "string", "maxLength": 128}},
      "DiscoveryId": {"name": "discovery_id", "in": "path", "required": true, "schema": {"type": "string", "maxLength": 128}},
      "ValidationId": {"name": "validation_id", "in": "path", "required": true, "schema": {"type": "string", "maxLength": 128}},
      "RevisionId": {"name": "revision_id", "in": "path", "required": true, "schema": {"type": "string", "maxLength": 128}},
      "RequestId": {"name": "X-Request-ID", "in": "header", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 256}},
      "IfMatch": {"name": "If-Match", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^\"(?:server|draft)-[1-9][0-9]*\"$"}},
      "Limit": {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50}},
      "Cursor": {"name": "cursor", "in": "query", "schema": {"type": "string", "maxLength": 4096}},
      "State": {"name": "state", "in": "query", "schema": {"enum": ["draft", "active", "disabled", "retired"]}},
      "DiscoveryStatus": {"name": "status", "in": "query", "schema": {"enum": ["pending", "running", "succeeded", "failed", "cancelled"]}}
    },
    "headers": {
      "CacheControl": {"schema": {"type": "string", "const": "private, no-store"}},
      "Etag": {"schema": {"type": "string"}},
      "Location": {"schema": {"type": "string", "format": "uri-reference"}}
    },
    "responses": {
      "Ok": {"description": "Successful safe projection", "headers": {"Cache-Control": {"$ref": "#/components/headers/CacheControl"}}, "content": {"application/json": {"schema": {"$ref": "mcp-management-v1.json#/$defs/successEnvelope"}}}},
      "OkWithEtag": {"description": "Successful versioned projection", "headers": {"Cache-Control": {"$ref": "#/components/headers/CacheControl"}, "ETag": {"$ref": "#/components/headers/Etag"}}, "content": {"application/json": {"schema": {"$ref": "mcp-management-v1.json#/$defs/successEnvelope"}}}},
      "Created": {"description": "Created immutable or versioned resource", "headers": {"Cache-Control": {"$ref": "#/components/headers/CacheControl"}, "Location": {"$ref": "#/components/headers/Location"}}, "content": {"application/json": {"schema": {"$ref": "mcp-management-v1.json#/$defs/successEnvelope"}}}},
      "Accepted": {"description": "Accepted durable asynchronous operation", "headers": {"Cache-Control": {"$ref": "#/components/headers/CacheControl"}, "Location": {"$ref": "#/components/headers/Location"}}, "content": {"application/json": {"schema": {"$ref": "mcp-management-v1.json#/$defs/successEnvelope"}}}},
      "Error": {"description": "Closed safe error envelope; inspect HTTP status and stable code", "headers": {"Cache-Control": {"$ref": "#/components/headers/CacheControl"}}, "content": {"application/json": {"schema": {"$ref": "mcp-management-v1.json#/$defs/errorEnvelope"}}}}
    }
  }
}
