      "delete":{"operationId":"deactivateProviderRevision","tags":["Lifecycle"],"parameters":[{"$ref":"#/components/parameters/RequestId"},{"$ref":"#/components/parameters/ProviderIfMatch"}],"responses":{"200":{"$ref":"#/components/responses/OkWithEtag"}}}
