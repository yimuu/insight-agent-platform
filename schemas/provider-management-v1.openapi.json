    "/v1/admin/providers/{provider_id}/suspension":{
      "parameters":[{"$ref":"#/components/parameters/ProviderId"}],
      "post":{"operationId":"suspendProvider","tags":["Lifecycle"],"parameters":[{"$ref":"#/components/parameters/RequestId"},{"$ref":"#/components/parameters/ProviderIfMatch"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"provider-management-v1.json#/$defs/reasonRequest"}}}},"responses":{"200":{"$ref":"#/components/responses/OkWithEtag"}}},
      "delete":{"operationId":"resumeProvider","tags":["Lifecycle"],"parameters":[{"$ref":"#/components/parameters/RequestId"},{"$ref":"#/components/parameters/ProviderIfMatch"}],"responses":{"200":{"$ref":"#/components/responses/OkWithEtag"}}}
    },
    "/v1/admin/providers/{provider_id}/retirement":{"parameters":[{"$ref":"#/components/parameters/ProviderId"}],"post":{"operationId":"retireProvider","tags":["Lifecycle"],"parameters":[{"$ref":"#/components/parameters/RequestId"},{"$ref":"#/components/parameters/ProviderIfMatch"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"provider-management-v1.json#/$defs/reasonRequest"}}}},"responses":{"200":{"$ref":"#/components/responses/OkWithEtag"}}}}
  },
  "components":{
    "securitySchemes":{"operatorBearer":{"type":"http","scheme":"bearer"}},
    "parameters":{
      "ProviderId":{"name":"provider_id","in":"path","required":true,"schema":{"$ref":"provider-management-v1.json#/$defs/providerId"}},
      "DiscoveryId":{"name":"discovery_id","in":"path","required":true,"schema":{"type":"string"}},
      "ValidationId":{"name":"validation_id","in":"path","required":true,"schema":{"type":"string"}},
      "TestId":{"name":"test_id","in":"path","required":true,"schema":{"type":"string"}},
      "RevisionId":{"name":"revision_id","in":"path","required":true,"schema":{"type":"string"}},
      "RequestId":{"name":"X-Request-Id","in":"header","required":true,"schema":{"type":"string","minLength":1,"maxLength":256}},
      "ProviderIfMatch":{"name":"If-Match","in":"header","required":true,"schema":{"type":"string","pattern":"^\\\"provider-[1-9][0-9]*\\\"$"}},
      "DraftIfMatch":{"name":"If-Match","in":"header","required":true,"schema":{"type":"string","pattern":"^\\\"draft-[1-9][0-9]*\\\"$"}},
      "Cursor":{"name":"cursor","in":"query","required":false,"schema":{"type":"string"}},
      "Limit":{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":200}}
    },
    "headers":{"CacheControl":{"schema":{"type":"string","const":"private, no-store"}},"Etag":{"schema":{"type":"string"}},"Location":{"schema":{"type":"string"}}},
    "responses":{
      "Ok":{"description":"Successful safe projection","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControl"}},"content":{"application/json":{"schema":{"$ref":"provider-management-v1.json#/$defs/successEnvelope"}}}},
      "OkWithEtag":{"description":"Successful versioned projection","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControl"},"ETag":{"$ref":"#/components/headers/Etag"}},"content":{"application/json":{"schema":{"$ref":"provider-management-v1.json#/$defs/successEnvelope"}}}},
      "Created":{"description":"Created resource","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControl"},"Location":{"$ref":"#/components/headers/Location"}},"content":{"application/json":{"schema":{"$ref":"provider-management-v1.json#/$defs/successEnvelope"}}}},
      "Accepted":{"description":"Accepted durable operation","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControl"},"Location":{"$ref":"#/components/headers/Location"}},"content":{"application/json":{"schema":{"$ref":"provider-management-v1.json#/$defs/successEnvelope"}}}},
      "Error":{"description":"Stable safe error","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControl"}},"content":{"application/json":{"schema":{"$ref":"provider-management-v1.json#/$defs/errorEnvelope"}}}}
    }
  }
}
