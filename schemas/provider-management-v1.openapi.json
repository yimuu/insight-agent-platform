{
  "openapi":"3.1.0",
  "info":{"title":"Insight Provider Management API","version":"1.0.0"},
  "servers":[{"url":"/"}],
  "security":[{"operatorBearer":[]}],
  "paths":{
    "/v1/admin/provider-templates":{"get":{"operationId":"listProviderTemplates","tags":["Templates"],"responses":{"200":{"$ref":"#/components/responses/Ok"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"}}}},
    "/v1/admin/providers":{
      "get":{"operationId":"listProviders","tags":["Providers"],"parameters":[{"$ref":"#/components/parameters/Cursor"},{"$ref":"#/components/parameters/Limit"}],"responses":{"200":{"$ref":"#/components/responses/Ok"}}},
      "post":{"operationId":"createProvider","tags":["Providers"],"parameters":[{"$ref":"#/components/parameters/RequestId"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"provider-management-v1.json#/$defs/createProviderRequest"}}}},"responses":{"201":{"$ref":"#/components/responses/Created"},"400":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"}}}
    },
