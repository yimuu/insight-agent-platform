    },
    "/v1/admin/providers/{provider_id}/discoveries":{"parameters":[{"$ref":"#/components/parameters/ProviderId"}],"post":{"operationId":"createProviderDiscovery","tags":["Discovery"],"parameters":[{"$ref":"#/components/parameters/RequestId"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"provider-management-v1.json#/$defs/draftVersionRequest"}}}},"responses":{"202":{"$ref":"#/components/responses/Accepted"},"409":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"}}}},
    "/v1/admin/providers/{provider_id}/discoveries/{discovery_id}":{
      "parameters":[{"$ref":"#/components/parameters/ProviderId"},{"$ref":"#/components/parameters/DiscoveryId"}],
      "get":{"operationId":"getProviderDiscovery","tags":["Discovery"],"responses":{"200":{"$ref":"#/components/responses/Ok"},"404":{"$ref":"#/components/responses/Error"}}},
      "delete":{"operationId":"cancelProviderDiscovery","tags":["Discovery"],"parameters":[{"$ref":"#/components/parameters/RequestId"}],"responses":{"202":{"$ref":"#/components/responses/Accepted"}}}
    },
    "/v1/admin/providers/{provider_id}/discoveries/{discovery_id}/model-candidates":{"parameters":[{"$ref":"#/components/parameters/ProviderId"},{"$ref":"#/components/parameters/DiscoveryId"}],"get":{"operationId":"listProviderModelCandidates","tags":["Discovery"],"parameters":[{"$ref":"#/components/parameters/Cursor"},{"$ref":"#/components/parameters/Limit"}],"responses":{"200":{"$ref":"#/components/responses/Ok"}}}},
    "/v1/admin/providers/{provider_id}/model-import-previews":{"parameters":[{"$ref":"#/components/parameters/ProviderId"}],"post":{"operationId":"previewProviderModelImports","tags":["Draft"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"provider-management-v1.json#/$defs/modelImportPreviewRequest"}}}},"responses":{"200":{"$ref":"#/components/responses/Ok"},"409":{"$ref":"#/components/responses/Error"}}}},
    "/v1/admin/providers/{provider_id}/draft/models":{"parameters":[{"$ref":"#/components/parameters/ProviderId"}],"put":{"operationId":"replaceProviderModels","tags":["Draft"],"parameters":[{"$ref":"#/components/parameters/RequestId"},{"$ref":"#/components/parameters/DraftIfMatch"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"provider-management-v1.json#/$defs/replaceModelsRequest"}}}},"responses":{"200":{"$ref":"#/components/responses/OkWithEtag"}}}},
    "/v1/admin/providers/{provider_id}/validations":{"parameters":[{"$ref":"#/components/parameters/ProviderId"}],"post":{"operationId":"createProviderValidation","tags":["Publication"],"parameters":[{"$ref":"#/components/parameters/RequestId"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"provider-management-v1.json#/$defs/draftVersionRequest"}}}},"responses":{"202":{"$ref":"#/components/responses/Accepted"},"422":{"$ref":"#/components/responses/Error"}}}},
    "/v1/admin/providers/{provider_id}/validations/{validation_id}":{"parameters":[{"$ref":"#/components/parameters/ProviderId"},{"$ref":"#/components/parameters/ValidationId"}],"get":{"operationId":"getProviderValidation","tags":["Publication"],"responses":{"200":{"$ref":"#/components/responses/Ok"}}}},
    "/v1/admin/providers/{provider_id}/connection-tests":{"parameters":[{"$ref":"#/components/parameters/ProviderId"}],"post":{"operationId":"createProviderConnectionTest","tags":["Tests"],"parameters":[{"$ref":"#/components/parameters/RequestId"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"provider-management-v1.json#/$defs/connectionTestRequest"}}}},"responses":{"202":{"$ref":"#/components/responses/Accepted"},"429":{"$ref":"#/components/responses/Error"}}}},
    "/v1/admin/providers/{provider_id}/connection-tests/{test_id}":{
      "parameters":[{"$ref":"#/components/parameters/ProviderId"},{"$ref":"#/components/parameters/TestId"}],
      "get":{"operationId":"getProviderConnectionTest","tags":["Tests"],"responses":{"200":{"$ref":"#/components/responses/Ok"}}},
      "delete":{"operationId":"cancelProviderConnectionTest","tags":["Tests"],"parameters":[{"$ref":"#/components/parameters/RequestId"}],"responses":{"202":{"$ref":"#/components/responses/Accepted"}}}
    },
    "/v1/admin/providers/{provider_id}/revisions":{
      "parameters":[{"$ref":"#/components/parameters/ProviderId"}],
      "get":{"operationId":"listProviderRevisions","tags":["Publication"],"parameters":[{"$ref":"#/components/parameters/Cursor"},{"$ref":"#/components/parameters/Limit"}],"responses":{"200":{"$ref":"#/components/responses/Ok"}}},
      "post":{"operationId":"publishProviderRevision","tags":["Publication"],"parameters":[{"$ref":"#/components/parameters/RequestId"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"provider-management-v1.json#/$defs/publishRequest"}}}},"responses":{"201":{"$ref":"#/components/responses/Created"},"409":{"$ref":"#/components/responses/Error"},"422":{"$ref":"#/components/responses/Error"}}}
    },
    "/v1/admin/providers/{provider_id}/revisions/{revision_id}":{"parameters":[{"$ref":"#/components/parameters/ProviderId"},{"$ref":"#/components/parameters/RevisionId"}],"get":{"operationId":"getProviderRevision","tags":["Publication"],"responses":{"200":{"$ref":"#/components/responses/Ok"}}}},
    "/v1/admin/providers/{provider_id}/active-revision":{
      "parameters":[{"$ref":"#/components/parameters/ProviderId"}],
      "get":{"operationId":"getActiveProviderRevision","tags":["Lifecycle"],"responses":{"200":{"$ref":"#/components/responses/Ok"}}},
