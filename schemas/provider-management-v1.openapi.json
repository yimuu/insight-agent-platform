      "delete":{"operationId":"deleteProvider","tags":["Providers"],"parameters":[{"$ref":"#/components/parameters/RequestId"},{"$ref":"#/components/parameters/ProviderIfMatch"}],"responses":{"200":{"$ref":"#/components/responses/Ok"},"409":{"$ref":"#/components/responses/Error"},"412":{"$ref":"#/components/responses/Error"},"428":{"$ref":"#/components/responses/Error"}}}
    },
