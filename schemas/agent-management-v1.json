{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://insight-agent.local/schemas/agent-management-v1.json",
  "title":"Insight Agent Management API v1",
  "$defs":{
    "agentId":{"type":"string","pattern":"^[a-z0-9][a-z0-9_-]{0,63}$"},
    "sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "closedEmptyRequest":{"type":"object","additionalProperties":false,"maxProperties":0},
    "labels":{"type":"object","maxProperties":128,"additionalProperties":{"type":["string","number","boolean","null"],"maxLength":4096}},
    "promptFile":{
      "type":"object","additionalProperties":false,"required":["path","content"],
      "properties":{"path":{"type":"string","minLength":1,"maxLength":512,"pattern":"^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//).+$"},"content":{"type":"string","maxLength":1048576}}
    },
    "yamlPackageSource":{
      "type":"object","additionalProperties":false,"required":["type","agent_yaml"],
      "properties":{"type":{"const":"yaml_package"},"agent_yaml":{"type":"string","minLength":1,"maxLength":4194304},"prompt_files":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/promptFile"}}}
    },
    "graphSource":{
      "type":"object","additionalProperties":false,"required":["type","document"],
      "properties":{"type":{"const":"graph"},"document":{"$ref":"#/$defs/graphAuthorDocument"}}
    },
    "graphAuthorDocument":{
      "type":"object","additionalProperties":false,
      "required":["schema_version","document_id","authoring_mode","metadata","nodes","ports","edges","bindings","scopes","policies","source_map"],
      "properties":{
        "schema_version":{"const":2},
        "document_id":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$"},
        "authoring_mode":{"const":"graph"},
        "metadata":{"type":"object"},
        "nodes":{"type":"array","maxItems":65536,"items":{"type":"object"}},
        "ports":{"type":"object","additionalProperties":false,"required":["control","data"],"properties":{"control":{"type":"array","maxItems":131072,"items":{"type":"object"}},"data":{"type":"array","maxItems":131072,"items":{"type":"object"}}}},
        "edges":{"type":"object","additionalProperties":false,"required":["control"],"properties":{"control":{"type":"array","maxItems":131072,"items":{"type":"object"}}}},
        "bindings":{"type":"object","additionalProperties":false,"required":["data","phi"],"properties":{"data":{"type":"array","maxItems":131072,"items":{"type":"object"}},"phi":{"type":"array","maxItems":131072,"items":{"type":"object"}}}},
        "scopes":{"type":"array","maxItems":65536,"items":{"type":"object"}},
        "policies":{"type":"array","maxItems":65536,"items":{"type":"object"}},
        "source_map":{"type":"object"},
        "structured_reduction":{"type":"object"}
      }
    },
    "graphSemanticEditBatch":{
      "type":"object","additionalProperties":false,
      "required":["schema_version","expected_semantic_hash","target_definition_revision_id","edits"],
      "properties":{
        "schema_version":{"const":1},
        "expected_semantic_hash":{"$ref":"#/$defs/sha256"},
        "target_definition_revision_id":{"type":"string","minLength":1,"maxLength":128},
        "edits":{"type":"array","minItems":1,"maxItems":4096,"items":{"$ref":"#/$defs/graphSemanticEdit"}}
      }
    },
    "graphSemanticEdit":{
      "type":"object","required":["op"],
      "oneOf":[
        {"properties":{"op":{"enum":["upsert_node","upsert_control_port","upsert_data_port"]},"node":{"type":"object"},"port":{"type":"object"}},"minProperties":2,"maxProperties":2,"additionalProperties":false},
        {"properties":{"op":{"enum":["delete_node","delete_control_port","delete_data_port"]},"node_id":{"type":"string"},"port_id":{"type":"string"}},"minProperties":2,"maxProperties":2,"additionalProperties":false},
        {"properties":{"op":{"enum":["upsert_control_edge","upsert_data_binding","upsert_phi_binding","upsert_scope","upsert_policy"]},"edge":{"type":"object"},"binding":{"type":"object"},"scope":{"type":"object"},"policy":{"type":"object"}},"minProperties":2,"maxProperties":2,"additionalProperties":false},
        {"properties":{"op":{"enum":["delete_control_edge","delete_data_binding","delete_phi_binding","delete_scope","delete_policy"]},"edge_id":{"type":"string"},"binding_id":{"type":"string"},"scope_id":{"type":"string"},"policy_id":{"type":"string"}},"minProperties":2,"maxProperties":2,"additionalProperties":false},
        {"properties":{"op":{"enum":["branch","map","loop"]},"node_id":{"type":"string"},"descriptor":{"type":"object"}},"required":["node_id","descriptor"],"additionalProperties":false},
        {"properties":{"op":{"const":"parallel"},"fork_node_id":{"type":"string"},"fork":{"type":"object"},"join_node_id":{"type":"string"},"join":{"type":"object"}},"required":["fork_node_id","fork","join_node_id","join"],"additionalProperties":false}
      ]
    },
    "canvasPoint":{"type":"object","additionalProperties":false,"required":["x","y"],"properties":{"x":{"type":"number"},"y":{"type":"number"}}},
    "nodeView":{"type":"object","additionalProperties":false,"required":["position"],"properties":{"position":{"$ref":"#/$defs/canvasPoint"},"size":{"type":"object","additionalProperties":false,"required":["width","height"],"properties":{"width":{"type":"number","exclusiveMinimum":0},"height":{"type":"number","exclusiveMinimum":0}}},"color":{"type":"string","maxLength":128},"annotation":{"type":"string","maxLength":65536},"collapsed":{"type":"boolean"}}},
    "viewDocument":{"type":"object","additionalProperties":false,"required":["schema_version","graph_document_id","viewport","nodes"],"properties":{"schema_version":{"const":1},"graph_document_id":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$"},"viewport":{"type":"object","additionalProperties":false,"required":["origin","zoom"],"properties":{"origin":{"$ref":"#/$defs/canvasPoint"},"zoom":{"type":"number","exclusiveMinimum":0}}},"nodes":{"type":"object","maxProperties":65536,"additionalProperties":{"$ref":"#/$defs/nodeView"}}}},
    "draft":{
      "type":"object","additionalProperties":false,"required":["source"],
      "properties":{"source":{"oneOf":[{"$ref":"#/$defs/yamlPackageSource"},{"$ref":"#/$defs/graphSource"}]}}
    },
    "createAgentRequest":{
      "type":"object","additionalProperties":false,"required":["agent_id","authoring_mode","draft"],
      "properties":{"agent_id":{"$ref":"#/$defs/agentId"},"authoring_mode":{"enum":["yaml_package","graph"]},"labels":{"$ref":"#/$defs/labels"},"draft":{"$ref":"#/$defs/draft"}}
    },
    "updateAgentRequest":{"type":"object","additionalProperties":false,"required":["labels"],"properties":{"labels":{"$ref":"#/$defs/labels"}}},
    "publishRequest":{"type":"object","additionalProperties":false,"required":["validation_id"],"properties":{"validation_id":{"type":"string","pattern":"^agentval_[A-Za-z0-9_-]{1,120}$"}}},
    "createResolutionRequest":{"type":"object","additionalProperties":false,"required":["definition_revision_id"],"properties":{"definition_revision_id":{"type":"string","pattern":"^defrev_[A-Za-z0-9_-]{1,120}$"}}},
    "createDeploymentRequest":{"type":"object","additionalProperties":false,"required":["resolution_id"],"properties":{"resolution_id":{"type":"string","pattern":"^agentres_[A-Za-z0-9_-]{1,120}$"}}},
    "activateRequest":{"type":"object","additionalProperties":false,"required":["deployment_revision_id"],"properties":{"deployment_revision_id":{"type":"string","pattern":"^deployrev_[A-Za-z0-9_-]{1,120}$"}}},
    "debugSource":{
      "oneOf":[
        {"type":"object","additionalProperties":false,"required":["type","draft_version"],"properties":{"type":{"const":"draft"},"draft_version":{"type":"integer","minimum":1}}},
        {"type":"object","additionalProperties":false,"required":["type","definition_revision_id"],"properties":{"type":{"const":"definition"},"definition_revision_id":{"type":"string","minLength":1,"maxLength":128}}},
        {"type":"object","additionalProperties":false,"required":["type","deployment_revision_id"],"properties":{"type":{"const":"deployment"},"deployment_revision_id":{"type":"string","minLength":1,"maxLength":128}}}
      ]
    },
    "createDebugSessionRequest":{
      "type":"object","additionalProperties":false,"required":["source","execution_profile_id","input"],
      "properties":{"source":{"$ref":"#/$defs/debugSource"},"execution_profile_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},"input":true,"live_confirmation":{"type":"boolean"}}
    },
    "successEnvelope":{"type":"object","additionalProperties":false,"required":["code","message","data"],"properties":{"code":{"const":"OK"},"message":{"const":"ok"},"data":true}},
    "errorEnvelope":{"type":"object","additionalProperties":false,"required":["code","message","data"],"properties":{"code":{"type":"string","pattern":"^[A-Z0-9_]+$"},"message":{"type":"string","maxLength":512},"data":{"type":"null"}}}
  }
}
