{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:insight-agent-platform:run-stream:v1",
  "title": "Insight Agent Platform run-stream/v1",
  "description": "Closed public SSE data-frame schema for one attached Run.",
  "oneOf": [
    {"$ref": "#/$defs/runLifecycleCreated"},
    {"$ref": "#/$defs/runLifecycleRunning"},
    {"$ref": "#/$defs/runOutputItemAdded"},
    {"$ref": "#/$defs/runOutputContentPartAdded"},
    {"$ref": "#/$defs/runOutputTextDelta"},
    {"$ref": "#/$defs/runOutputTextDone"},
    {"$ref": "#/$defs/runOutputContentPartDone"},
    {"$ref": "#/$defs/runOutputFunctionCallArgumentsDelta"},
    {"$ref": "#/$defs/runOutputFunctionCallArgumentsDone"},
    {"$ref": "#/$defs/runOutputItemDone"},
    {"$ref": "#/$defs/runOutputFileSearchCallInProgress"},
    {"$ref": "#/$defs/runOutputFileSearchCallSearching"},
    {"$ref": "#/$defs/runOutputFileSearchCallCompleted"},
    {"$ref": "#/$defs/runLifecycleCompleted"},
    {"$ref": "#/$defs/runLifecycleFailed"},
    {"$ref": "#/$defs/runStreamError"},
    {"$ref": "#/$defs/runToolStarted"},
    {"$ref": "#/$defs/runToolProgress"},
    {"$ref": "#/$defs/runToolCompleted"},
    {"$ref": "#/$defs/runToolFailed"},
    {"$ref": "#/$defs/runRetrievalCompleted"},
    {"$ref": "#/$defs/runStreamGap"},
    {"$ref": "#/$defs/runLifecycleTimedOut"},
    {"$ref": "#/$defs/runLifecycleCancelled"},
    {"$ref": "#/$defs/runLifecycleInterrupted"}
  ],
  "$defs": {
    "publicLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s/\\\\]+$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "usageStatus": {
      "enum": ["complete", "partial", "unavailable"]
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "input_tokens_details": {
          "type": "object",
          "properties": {
            "cached_tokens": {"type": "integer", "minimum": 0}
          },
          "required": ["cached_tokens"],
          "additionalProperties": false
        },
        "output_tokens": {"type": "integer", "minimum": 0},
        "output_tokens_details": {
          "type": "object",
          "properties": {
            "reasoning_tokens": {"type": "integer", "minimum": 0}
          },
          "required": ["reasoning_tokens"],
          "additionalProperties": false
        },
        "total_tokens": {"type": "integer", "minimum": 0}
      },
      "required": [
        "input_tokens",
        "input_tokens_details",
        "output_tokens",
        "output_tokens_details",
        "total_tokens"
      ],
      "additionalProperties": false
    },
    "publicError": {
      "type": "object",
      "properties": {
        "code": {"$ref": "#/$defs/publicLabel"},
        "message": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "outputTextPart": {
      "type": "object",
      "properties": {
        "type": {"const": "output_text"},
        "text": {"type": "string"},
        "annotations": {"type": "array"}
      },
      "required": ["type", "text", "annotations"],
      "additionalProperties": false
    },
    "messageItem": {
      "type": "object",
      "properties": {
        "type": {"const": "message"},
        "id": {"$ref": "#/$defs/publicLabel"},
        "status": {"enum": ["in_progress", "completed", "failed", "incomplete"]},
        "role": {"const": "assistant"},
        "content": {
          "type": "array",
          "items": {"$ref": "#/$defs/outputTextPart"}
        }
      },
      "required": ["type", "id", "status", "role", "content"],
      "additionalProperties": false
    },
    "functionCallItem": {
      "type": "object",
      "properties": {
        "type": {"const": "function_call"},
        "id": {"$ref": "#/$defs/publicLabel"},
        "status": {"enum": ["in_progress", "completed", "failed", "incomplete"]},
        "call_id": {"$ref": "#/$defs/publicLabel"},
        "name": {"$ref": "#/$defs/publicLabel"},
        "arguments": {"type": "string"}
      },
      "required": ["type", "id", "status", "call_id", "name", "arguments"],
      "additionalProperties": false
    },
    "fileSearchCallItem": {
      "type": "object",
      "properties": {
        "type": {"const": "file_search_call"},
        "id": {"$ref": "#/$defs/publicLabel"},
        "status": {"enum": ["in_progress", "completed", "failed", "incomplete"]},
        "queries": {"type": "array", "items": {"type": "string"}},
        "results": {"type": "array"}
      },
      "required": ["type", "id", "status", "queries", "results"],
      "additionalProperties": false
    },
    "outputItem": {
      "oneOf": [
        {"$ref": "#/$defs/messageItem"},
        {"$ref": "#/$defs/functionCallItem"},
        {"$ref": "#/$defs/fileSearchCallItem"}
      ]
    },
    "artifact": {
      "type": "object",
      "properties": {
        "artifact_id": {"$ref": "#/$defs/publicLabel"},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "media_type": {"type": ["string", "null"]}
      },
      "required": ["artifact_id", "content_hash", "size_bytes", "media_type"],
      "additionalProperties": false
    },
    "toolProgressContent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {"const": "output_text"},
            "text": {"type": "string", "minLength": 1}
          },
          "required": ["type", "text"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {"const": "output_json"},
            "json": {}
          },
          "required": ["type", "json"],
          "additionalProperties": false
        }
      ]
    },
    "toolContent": {
      "oneOf": [
        {"$ref": "#/$defs/toolProgressContent"},
        {
          "type": "object",
          "properties": {
            "type": {"const": "output_image"},
            "artifact": {"$ref": "#/$defs/artifact"}
          },
          "required": ["type", "artifact"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {"const": "output_file"},
            "artifact": {"$ref": "#/$defs/artifact"}
          },
          "required": ["type", "artifact"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {"const": "output_audio"},
            "artifact": {"$ref": "#/$defs/artifact"}
          },
          "required": ["type", "artifact"],
          "additionalProperties": false
        }
      ]
    },
    "toolResult": {
      "type": "object",
      "properties": {
        "call_id": {"$ref": "#/$defs/publicLabel"},
        "tool_name": {"$ref": "#/$defs/publicLabel"},
        "content": {
          "type": "array",
          "maxItems": 128,
          "items": {"$ref": "#/$defs/toolContent"}
        }
      },
      "required": ["call_id", "tool_name", "content"],
      "additionalProperties": false
    },
    "retrievalResult": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/publicLabel"},
        "title": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "score": {"type": "number"},
        "snippet": {"type": "string", "minLength": 1},
        "metadata": {"type": "object"},
        "artifact": {"$ref": "#/$defs/artifact"}
      },
      "required": ["id", "metadata"],
      "additionalProperties": false
    },
    "retrieval": {
      "type": "object",
      "properties": {
        "retrieval_id": {"$ref": "#/$defs/publicLabel"},
        "query": {"type": "string", "minLength": 1},
        "results": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/retrievalResult"}
        }
      },
      "required": ["retrieval_id", "results"],
      "additionalProperties": false
    },
    "runCreated": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/publicLabel"},
        "object": {"const": "run"},
        "status": {"const": "created"},
        "output": {"type": "array", "maxItems": 0},
        "usage": {"type": "null"}
      },
      "required": ["id", "object", "status", "output", "usage"],
      "additionalProperties": false
    },
    "runRunning": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/publicLabel"},
        "object": {"const": "run"},
        "status": {"const": "running"},
        "output": {"type": "array", "maxItems": 0},
        "usage": {"type": "null"}
      },
      "required": ["id", "object", "status", "output", "usage"],
      "additionalProperties": false
    },
    "runCompleted": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/publicLabel"},
        "object": {"const": "run"},
        "status": {"const": "completed"},
        "output": {"type": "array", "items": {"$ref": "#/$defs/outputItem"}},
        "result": {},
        "tool_results": {"type": "array", "items": {"$ref": "#/$defs/toolResult"}},
        "retrievals": {"type": "array", "items": {"$ref": "#/$defs/retrieval"}},
        "usage": {"oneOf": [{"$ref": "#/$defs/usage"}, {"type": "null"}]},
        "usage_status": {"$ref": "#/$defs/usageStatus"}
      },
      "required": [
        "id",
        "object",
        "status",
        "output",
        "result",
        "tool_results",
        "retrievals",
        "usage",
        "usage_status"
      ],
      "additionalProperties": false
    },
    "runFailed": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/publicLabel"},
        "object": {"const": "run"},
        "status": {"const": "failed"},
        "output": {"type": "array", "items": {"$ref": "#/$defs/outputItem"}},
        "error": {"$ref": "#/$defs/publicError"},
        "tool_results": {"type": "array", "items": {"$ref": "#/$defs/toolResult"}},
        "retrievals": {"type": "array", "items": {"$ref": "#/$defs/retrieval"}},
        "usage": {"oneOf": [{"$ref": "#/$defs/usage"}, {"type": "null"}]},
        "usage_status": {"$ref": "#/$defs/usageStatus"}
      },
      "required": [
        "id",
        "object",
        "status",
        "output",
        "error",
        "tool_results",
        "retrievals",
        "usage",
        "usage_status"
      ],
      "additionalProperties": false
    },
    "runTimedOut": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/publicLabel"},
        "object": {"const": "run"},
        "status": {"const": "timed_out"},
        "output": {"type": "array", "items": {"$ref": "#/$defs/outputItem"}},
        "error": {"$ref": "#/$defs/publicError"},
        "tool_results": {"type": "array", "items": {"$ref": "#/$defs/toolResult"}},
        "retrievals": {"type": "array", "items": {"$ref": "#/$defs/retrieval"}},
        "usage": {"oneOf": [{"$ref": "#/$defs/usage"}, {"type": "null"}]},
        "usage_status": {"$ref": "#/$defs/usageStatus"}
      },
      "required": [
        "id",
        "object",
        "status",
        "output",
        "error",
        "tool_results",
        "retrievals",
        "usage",
        "usage_status"
      ],
      "additionalProperties": false
    },
    "runCancelled": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/publicLabel"},
        "object": {"const": "run"},
        "status": {"const": "cancelled"},
        "output": {"type": "array", "items": {"$ref": "#/$defs/outputItem"}},
        "tool_results": {"type": "array", "items": {"$ref": "#/$defs/toolResult"}},
        "retrievals": {"type": "array", "items": {"$ref": "#/$defs/retrieval"}},
        "usage": {"oneOf": [{"$ref": "#/$defs/usage"}, {"type": "null"}]},
        "usage_status": {"$ref": "#/$defs/usageStatus"}
      },
      "required": [
        "id",
        "object",
        "status",
        "output",
        "tool_results",
        "retrievals",
        "usage",
        "usage_status"
      ],
      "additionalProperties": false
    },
    "runInterrupted": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/publicLabel"},
        "object": {"const": "run"},
        "status": {"const": "interrupted"},
        "output": {"type": "array", "items": {"$ref": "#/$defs/outputItem"}},
        "tool_results": {"type": "array", "items": {"$ref": "#/$defs/toolResult"}},
        "retrievals": {"type": "array", "items": {"$ref": "#/$defs/retrieval"}},
        "usage": {"oneOf": [{"$ref": "#/$defs/usage"}, {"type": "null"}]},
        "usage_status": {"$ref": "#/$defs/usageStatus"}
      },
      "required": [
        "id",
        "object",
        "status",
        "output",
        "tool_results",
        "retrievals",
        "usage",
        "usage_status"
      ],
      "additionalProperties": false
    },
    "runLifecycleCreated": {
      "type": "object",
      "properties": {
        "type": {"const": "run.lifecycle.created"},
        "sequence_number": {"$ref": "#/$defs/sequence"},
        "run": {"$ref": "#/$defs/runCreated"}
      },
      "required": ["type", "sequence_number", "run"],
      "additionalProperties": false
    },
    "runLifecycleRunning": {
      "type": "object",
      "properties": {
        "type": {"const": "run.lifecycle.running"},
        "sequence_number": {"$ref": "#/$defs/sequence"},
        "run": {"$ref": "#/$defs/runRunning"}
      },
      "required": ["type", "sequence_number", "run"],
      "additionalProperties": false
    },
    "runOutputItemAdded": {
      "type": "object",
      "properties": {
        "type": {"const": "run.output.item.added"},
        "sequence_number": {"$ref": "#/$defs/sequence"},
        "output_index": {"type": "integer", "minimum": 0},
        "item": {"$ref": "#/$defs/outputItem"}
      },
      "required": ["type", "sequence_number", "output_index", "item"],
      "additionalProperties": false
    },
    "runOutputContentPartAdded": {
      "type": "object",
      "properties": {
        "type": {"const": "run.output.content_part.added"},
        "sequence_number": {"$ref": "#/$defs/sequence"},
        "item_id": {"$ref": "#/$defs/publicLabel"},
        "output_index": {"type": "integer", "minimum": 0},
        "content_index": {"type": "integer", "minimum": 0},
        "part": {"$ref": "#/$defs/outputTextPart"}
      },
      "required": [
        "type",
        "sequence_number",
        "item_id",
        "output_index",
        "content_index",
        "part"
      ],
      "additionalProperties": false
    },
    "runOutputTextDelta": {
      "type": "object",
      "properties": {
        "type": {"const": "run.output.text.delta"},
        "sequence_number": {"$ref": "#/$defs/sequence"},
        "item_id": {"$ref": "#/$defs/publicLabel"},
        "output_index": {"type": "integer", "minimum": 0},
        "content_index": {"type": "integer", "minimum": 0},
        "delta": {"type": "string"}
      },
      "required": [
        "type",
        "sequence_number",
        "item_id",
        "output_index",
        "content_index",
        "delta"
      ],
      "additionalProperties": false
    },
    "runOutputTextDone": {
      "type": "object",
      "properties": {
        "type": {"const": "run.output.text.done"},
        "sequence_number": {"$ref": "#/$defs/sequence"},
        "item_id": {"$ref": "#/$defs/publicLabel"},
        "output_index": {"type": "integer", "minimum": 0},
        "content_index": {"type": "integer", "minimum": 0},
        "text": {"type": "string"}
      },
      "required": [
        "type",
        "sequence_number",
        "item_id",
        "output_index",
        "content_index",
        "text"
      ],
      "additionalProperties": false
    },
    "runOutputContentPartDone": {
      "type": "object",
      "properties": {
        "type": {"const": "run.output.content_part.done"},
        "sequence_number": {"$ref": "#/$defs/sequence"},
        "item_id": {"$ref": "#/$defs/publicLabel"},
        "output_index": {"type": "integer", "minimum": 0},
        "content_index": {"type": "integer", "minimum": 0},
        "part": {"$ref": "#/$defs/outputTextPart"}
      },
      "required": [
        "type",
        "sequence_number",
        "item_id",
        "output_index",
        "content_index",
        "part"
      ],
      "additionalProperties": false
    },
    "runOutputFunctionCallArgumentsDelta": {
      "type": "object",
      "properties": {
        "type": {"const": "run.output.function_call.arguments.delta"},
        "sequence_number": {"$ref": "#/$defs/sequence"},
        "item_id": {"$ref": "#/$defs/publicLabel"},
        "output_index": {"type": "integer", "minimum": 0},
        "delta": {"type": "string"}
      },
      "required": ["type", "sequence_number", "item_id", "output_index", "delta"],
      "additionalProperties": false
    },
    "runOutputFunctionCallArgumentsDone": {
      "type": "object",
      "properties": {
        "type": {"const": "run.output.function_call.arguments.done"},
        "sequence_number": {"$ref": "#/$defs/sequence"},
        "item_id": {"$ref": "#/$defs/publicLabel"},
        "output_index": {"type": "integer", "minimum": 0},
        "name": {"$ref": "#/$defs/publicLabel"},
        "arguments": {"type": "string"}
      },
      "required": [
        "type",
        "sequence_number",
        "item_id",
        "output_index",
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "runOutputItemDone": {
      "type": "object",
      "properties": {
        "type": {"const": "run.output.item.done"},
        "sequence_number": {"$ref": "#/$defs/sequence"},
        "output_index": {"type": "integer", "minimum": 0},
        "item": {"$ref": "#/$defs/outputItem"}
      },
      "required": ["type", "sequence_number", "output_index", "item"],
      "additionalProperties": false
    },
    "runOutputFileSearchCallInProgress": {
      "$ref": "#/$defs/fileSearchInProgressEvent"
    },
    "runOutputFileSearchCallSearching": {
      "$ref": "#/$defs/fileSearchSearchingEvent"
    },
    "runOutputFileSearchCallCompleted": {
      "$ref": "#/$defs/fileSearchCompletedEvent"
    },
    "fileSearchInProgressEvent": {
      "type": "object",
      "properties": {
        "type": {"const": "run.output.file_search_call.in_progress"},
        "sequence_number": {"$ref": "#/$defs/sequence"},
        "item_id": {"$ref": "#/$defs/publicLabel"},
        "output_index": {"type": "integer", "minimum": 0}
      },
      "required": ["type", "sequence_number", "item_id", "output_index"],
      "additionalProperties": false
    },
    "fileSearchSearchingEvent": {
      "type": "object",
      "properties": {
        "type": {"const": "run.output.file_search_call.searching"},
        "sequence_number": {"$ref": "#/$defs/sequence"},
        "item_id": {"$ref": "#/$defs/publicLabel"},
        "output_index": {"type": "integer", "minimum": 0}
      },
      "required": ["type", "sequence_number", "item_id", "output_index"],
      "additionalProperties": false
    },
    "fileSearchCompletedEvent": {
      "type": "object",
      "properties": {
        "type": {"const": "run.output.file_search_call.completed"},
        "sequence_number": {"$ref": "#/$defs/sequence"},
        "item_id": {"$ref": "#/$defs/publicLabel"},
        "output_index": {"type": "integer", "minimum": 0}
      },
      "required": ["type", "sequence_number", "item_id", "output_index"],
      "additionalProperties": false
    },
    "runLifecycleCompleted": {
      "type": "object",
      "properties": {
        "type": {"const": "run.lifecycle.completed"},
        "sequence_number": {"$ref": "#/$defs/sequence"},
        "run": {"$ref": "#/$defs/runCompleted"}
      },
      "required": ["type", "sequence_number", "run"],
      "additionalProperties": false
    },
    "runLifecycleFailed": {
      "type": "object",
      "properties": {
        "type": {"const": "run.lifecycle.failed"},
        "sequence_number": {"$ref": "#/$defs/sequence"},
        "run": {"$ref": "#/$defs/runFailed"}
      },
      "required": ["type", "sequence_number", "run"],
      "additionalProperties": false
    },
    "runStreamError": {
      "type": "object",
      "properties": {
        "type": {"const": "run.stream.error"},
        "sequence_number": {"$ref": "#/$defs/sequence"},
        "code": {
          "type": "string",
          "minLength": 12,
          "maxLength": 128,
          "pattern": "^RUN_STREAM_[A-Z0-9_]+$"
        },
        "message": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "required": ["type", "sequence_number", "code", "message"],
      "additionalProperties": false
    },
    "runToolStarted": {
      "type": "object",
      "properties": {
        "type": {"const": "run.tool.started"},
        "sequence_number": {"$ref": "#/$defs/sequence"},
        "call_id": {"$ref": "#/$defs/publicLabel"},
        "tool_name": {"$ref": "#/$defs/publicLabel"},
        "arguments": {"type": "object"}
      },
      "required": ["type", "sequence_number", "call_id", "tool_name"],
      "additionalProperties": false
    },
    "runToolProgress": {
      "type": "object",
      "properties": {
        "type": {"const": "run.tool.progress"},
        "sequence_number": {"$ref": "#/$defs/sequence"},
        "call_id": {"$ref": "#/$defs/publicLabel"},
        "tool_name": {"$ref": "#/$defs/publicLabel"},
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"$ref": "#/$defs/toolProgressContent"}
        }
      },
      "required": ["type", "sequence_number", "call_id", "tool_name", "content"],
      "additionalProperties": false
    },
    "runToolCompleted": {
      "type": "object",
      "properties": {
        "type": {"const": "run.tool.completed"},
        "sequence_number": {"$ref": "#/$defs/sequence"},
        "call_id": {"$ref": "#/$defs/publicLabel"},
        "tool_name": {"$ref": "#/$defs/publicLabel"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "content": {
          "type": "array",
          "maxItems": 128,
          "items": {"$ref": "#/$defs/toolContent"}
        }
      },
      "required": [
        "type",
        "sequence_number",
        "call_id",
        "tool_name",
        "duration_ms",
        "content"
      ],
      "additionalProperties": false
    },
    "runToolFailed": {
      "type": "object",
      "properties": {
        "type": {"const": "run.tool.failed"},
        "sequence_number": {"$ref": "#/$defs/sequence"},
        "call_id": {"$ref": "#/$defs/publicLabel"},
        "tool_name": {"$ref": "#/$defs/publicLabel"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "error": {"$ref": "#/$defs/publicError"}
      },
      "required": [
        "type",
        "sequence_number",
        "call_id",
        "tool_name",
        "duration_ms",
        "error"
      ],
      "additionalProperties": false
    },
    "runRetrievalCompleted": {
      "type": "object",
      "properties": {
        "type": {"const": "run.retrieval.completed"},
        "sequence_number": {"$ref": "#/$defs/sequence"},
        "retrieval_id": {"$ref": "#/$defs/publicLabel"},
        "query": {"type": "string", "minLength": 1},
        "results": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/retrievalResult"}
        }
      },
