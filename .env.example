# Optional local deployment settings. Start with: docker compose up -d --build
# All database passwords and service certificates are generated inside the installation volume.
INSIGHT_NAME=my-platform
INSIGHT_HTTP_PORT=8088

# For prebuilt images, set these and run: docker compose up -d --no-build
# Model API keys do not belong here.
# INSIGHT_RUNTIME_IMAGE=your-registry/insight-runtime@sha256:...
# INSIGHT_CONSOLE_IMAGE=your-registry/insight-console@sha256:...
